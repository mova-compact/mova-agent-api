{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mova.dev/mova-agent-api/schemas/secret_ref.schema.json",
  "title": "MOVA Agent API V0 Secret Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "reference"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "secret_ref",
        "env_ref",
        "runtime_secret"
      ]
    },
    "reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
