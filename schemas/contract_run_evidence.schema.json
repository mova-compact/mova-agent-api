{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "contract_id",
    "tenant_id",
    "status",
    "result",
    "evidence",
    "trace_ref",
    "observation_refs",
    "policy_summary"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "contract_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["accepted", "in_progress", "waiting_review", "completed", "failed", "blocked"]
    },
    "result": { "type": "object" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "gates", "transitions", "transition_failures", "idempotency_key"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "operation_id",
              "decision",
              "reason_code",
              "admission",
              "connector_summary"
            ],
            "properties": {
              "step_id": { "type": "string" },
              "operation_id": {},
              "decision": { "type": "string" },
              "reason_code": { "type": "string" },
              "admission": { "type": "object" },
              "connector_summary": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "connector_id",
                      "endpoint_ref",
                      "method",
                      "side_effect_intent",
                      "connector_status",
                      "provider",
                      "connector_mode",
                      "response_preview",
                      "attempts",
                      "timeout_ms"
                    ],
                    "properties": {
                      "connector_id": { "type": "string" },
                      "endpoint_ref": { "type": "string" },
                      "method": { "type": "string" },
                      "side_effect_intent": { "type": "string" },
                      "connector_status": { "type": "string" },
                      "provider": { "type": "string" },
                      "connector_mode": { "type": "string" },
                      "response_preview": { "type": "object" },
                      "attempts": { "type": "integer" },
                      "timeout_ms": { "type": "integer" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "connector_id",
                      "endpoint_ref",
                      "connector_ref",
                      "operation",
                      "method",
                      "side_effect_intent",
                      "connector_status",
                      "provider",
                      "connector_mode",
                      "response_preview",
                      "attempts",
                      "timeout_ms"
                    ],
                    "properties": {
                      "connector_id": { "type": "string" },
                      "endpoint_ref": { "type": ["string", "null"] },
                      "connector_ref": { "type": "string" },
                      "operation": { "type": "string" },
                      "method": { "type": "string" },
                      "side_effect_intent": { "type": "string" },
                      "connector_status": { "type": "string" },
                      "provider": { "type": "string" },
                      "connector_mode": { "type": "string" },
                      "response_preview": { "type": "object" },
                      "attempts": { "type": "integer" },
                      "timeout_ms": { "type": "integer" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["provider", "decision_basis"],
                    "properties": {
                      "provider": { "type": "string" },
                      "decision_basis": { "type": "string" }
                    }
                  }
                ]
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate_id",
              "step_id",
              "requested_operation_id",
              "decision",
              "decided_by",
              "reason_code"
            ],
            "properties": {
              "gate_id": { "type": "string" },
              "step_id": { "type": "string" },
              "requested_operation_id": { "type": "string" },
              "decision": { "type": "string" },
              "decided_by": { "type": "string" },
              "reason_code": { "type": "string" }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_step_id",
              "outcome",
              "kind",
              "target_step_id",
              "terminal_status",
              "reason_code"
            ],
            "properties": {
              "from_step_id": { "type": "string" },
              "outcome": { "type": "string" },
              "kind": { "type": "string" },
              "target_step_id": { "type": ["string", "null"] },
              "terminal_status": { "type": ["string", "null"] },
              "reason_code": { "type": "string" }
            }
          }
        },
        "transition_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_step_id", "outcome", "reason_code", "error_code", "message"],
            "properties": {
              "from_step_id": { "type": "string" },
              "outcome": { "type": "string" },
              "reason_code": { "type": "string" },
              "error_code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "idempotency_key": { "type": ["string", "null"] }
      }
    },
    "trace_ref": { "type": "string" },
    "observation_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "policy_version", "reason_code"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allow", "deny", "require_review", "redact"]
        },
        "policy_version": { "type": "string" },
        "reason_code": { "type": "string" }
      }
    }
  }
}
