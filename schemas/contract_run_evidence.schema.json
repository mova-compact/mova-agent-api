{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "contract_id",
    "status",
    "result",
    "evidence",
    "trace_ref",
    "observation_refs",
    "policy_summary"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "contract_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["accepted", "in_progress", "waiting_review", "completed", "failed", "blocked"]
    },
    "result": { "type": "object" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "gates", "transitions"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "operation_id",
              "decision",
              "reason_code",
              "admission",
              "connector_summary"
            ],
            "properties": {
              "step_id": { "type": "string" },
              "operation_id": {},
              "decision": { "type": "string" },
              "reason_code": { "type": "string" },
              "admission": { "type": "object" },
              "connector_summary": { "type": "object" }
            }
          }
        },
        "gates": { "type": "array", "items": { "type": "object" } },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_step_id",
              "outcome",
              "kind",
              "target_step_id",
              "terminal_status",
              "reason_code"
            ],
            "properties": {
              "from_step_id": { "type": "string" },
              "outcome": { "type": "string" },
              "kind": { "type": "string" },
              "target_step_id": { "type": ["string", "null"] },
              "terminal_status": { "type": ["string", "null"] },
              "reason_code": { "type": "string" }
            }
          }
        }
      }
    },
    "trace_ref": { "type": "string" },
    "observation_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "policy_version", "reason_code"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allow", "deny", "require_review", "redact"]
        },
        "policy_version": { "type": "string" },
        "reason_code": { "type": "string" }
      }
    }
  }
}
