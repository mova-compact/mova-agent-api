{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_id",
    "decision",
    "reason_code",
    "policy_version",
    "contract_id",
    "run_id",
    "step_id",
    "operation_id",
    "constraints"
  ],
  "properties": {
    "admission_id": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny", "require_review", "redact"]
    },
    "reason_code": { "type": "string" },
    "policy_version": { "type": "string" },
    "contract_id": { "type": "string" },
    "run_id": { "type": "string" },
    "step_id": { "type": "string" },
    "operation_id": { "type": "string" },
    "allowed_connector_id": { "type": ["string", "null"] },
    "allowed_endpoint_ref": { "type": ["string", "null"] },
    "allowed_method": { "type": ["string", "null"] },
    "constraints": { "type": "object" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
